{
	"schemaVersion": 1,
	"id": "p2craft",
	"version": "${version}",
	"name": "p2craft",
	"description": "Connect to Minecraft servers directly using .p2p addresses, without public IPs or port forwarding.",
	"authors": [
		"Mihalic2040"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/p2craft",
		"sources": "https://github.com/Mihalic2040/p2craft"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/p2craft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mihalic2040.p2craft.P2craft"
		],
		"client": [
			"com.mihalic2040.p2craft.client.P2craftClient"
		]
	},
	"mixins": [
		"p2craft.mixins.json",
		{
			"config": "p2craft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*"
	}
}